.hidden {
    display: none;
}

body {
  font-family: "Roboto", sans-serif;
  color: #434455;
  background-color: #ffffff;
  margin: 0;
}

ul,
ol {
  list-style-type: none;
  margin: 0;
  padding: 0;
}
h1,
h2,
h3,
h4,
h5,
h6,
p {
    margin: 0;
}

a {
  text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

.button {
    cursor: pointer;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

.container {
  max-width: 320px;
  padding: 0 16px;
  margin: 0 auto;
}

@media screen and (min-width: 768px) {
  .container{
    max-width: 768px;
  }
}

@media screen and (min-width: 1158px) {
  .container {
    max-width: 1158px;
    padding: 0 15px;
  }
}

.header {
   border-bottom: 1px solid #e7e9fe;
   box-shadow: 0px 2px 1px rgba(46, 47, 66, 0.08),
              0px 1px 1px rgba(46, 47, 66, 0.16),
              0px 1px 6px rgba(46, 47, 66, 0.08);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-list, 
.contacts{
  display: none;
}

.logo, 
.footer-logo {
  font-family: "Raleway", sans-serif;
  font-weight: 700;
  font-size: 18px;
  line-height: 1.17;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #4d5ae5;
  text-decoration: none;
  margin-right: 76px;
  padding: 24px 0;
}

.header-logo {
  padding: 16px 0;
  display: block;
}

.logo-span,
.footer-logo-span {
  color: #2e2f42;
}

.burger-btn {
  background-color: transparent;
  border: none;
  padding: 0px;
}

.burger-icon {
    display: block;
    fill: #2e2f37;
}

@media screen and (min-width: 768px) {
  .burger-btn {
    display: none;
  }

.header-logo {
  padding: 24px 0;
  margin-right: 124px;
}

.header-nav {
  display: flex;
  align-items: center;
}

.nav-link {
  font-weight: 500;
  line-height: 1.5;
  font-size: 16px;
  color: #2e2f42;
  letter-spacing: 0.02em;
  padding: 24px 0; /* ✅ вертикальні відступи всередині посилання */
  display: block; /* щоб padding застосувався коректно по всій висоті */
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.nav-link.current {
  position: relative; /* ✅ щоб псевдоелемент позиціювати відносно посилання */
}

.nav-link.current::after {
  content: ""; /* ✅ обов'язково порожній */
  position: absolute; /* ✅ позиціюємо відносно батька */
  left: 0;
  bottom: -1px;
  width: 100%; /* ✅ по ширині батьківського елемента */
  height: 4px; /* ✅ товщина підкреслення */
  background-color: #404bbf; /* ✅ колір */
  border-radius: 2px; /* ✅ закруглені краї */
}

  .nav-list {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .contacts {
    font-style: normal;
    display: block;
 }

 .contact-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
 }

 .contact-link {
    display: block;
    line-height: 1.17;
    font-size: 12px;
    color: #434455;
    letter-spacing: 0.04em;
    transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
 }

.nav-link:hover,
.nav-link:focus {
  color: #404bbf;
}
}


@media screen and (min-width: 1158px) {
  .header-logo {
    margin-right: 76px;
  }
  .contact-list {
    align-items: center;
    flex-direction: row;
    gap: 40px;
 }
 .contact-link {
  padding: 24px 0;
    line-height: 1.5;
    font-size: 16px;
    letter-spacing: 0.02em;
 }
  }

 .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 250ms cubic-bezier(0.4, 0, 0.2, 1),
                visibility 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-container {
    position: relative;
    padding-top: 72px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mobile-menu-close {
    position: absolute;
    right: 16px;
    top: 16px;
  }

  .mobile-menu-nav {
    margin-bottom: auto;
  }

@media screen and (min-width: 768px) {
  .mobile-menu {
    display: none;
  }
  }
